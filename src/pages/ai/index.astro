  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. 向量相似度交互计算器
      const btnCalcVec = document.getElementById('btn-calc-vec')
      if (btnCalcVec) {
        btnCalcVec.addEventListener('click', () => {
          const uStr = document.getElementById('calc-vec-u').value.split(',')
          const vStr = document.getElementById('calc-vec-v').value.split(',')
          const u = uStr.map((n) => parseFloat(n.trim()) || 0)
          const v = vStr.map((n) => parseFloat(n.trim()) || 0)

          if (u.length < 2 || v.length < 2) {
            alert('请输入合法的 2 维坐标，例如：0.6, 0.8')
            return
          }

          const dot = u[0] * v[0] + u[1] * v[1]
          const normU = Math.sqrt(u[0] * u[0] + u[1] * u[1])
          const normV = Math.sqrt(v[0] * v[0] + v[1] * v[1])
          const cos = normU && normV ? dot / (normU * normV) : 0
          const l2 = Math.sqrt(Math.pow(u[0] - v[0], 2) + Math.pow(u[1] - v[1], 2))

          const resultBox = document.getElementById('calc-vec-result')
          resultBox.innerHTML = `
            <div style="font-size: 0.9rem; color: #334155;">
              <strong>计算结果</strong>：余弦相似度 Cos = <span style="color: #2563eb; font-weight: 700;">${cos.toFixed(4)}</span> |
              点积 Dot = <span style="color: #059669; font-weight: 700;">${dot.toFixed(4)}</span> (模长 ||u||=${normU.toFixed(2)}, ||v||=${normV.toFixed(2)}) |
              欧氏距离 L2 = <span style="color: #d97706; font-weight: 700;">${l2.toFixed(4)}</span>
            </div>
          `
        })
      }

      // 2. RRF 计算器
      const btnCalcRrf = document.getElementById('btn-calc-rrf')
      if (btnCalcRrf) {
        btnCalcRrf.addEventListener('click', () => {
          const r1 = parseInt(document.getElementById('calc-rrf-r1').value) || 1
          const r2 = parseInt(document.getElementById('calc-rrf-r2').value) || 1
          const k = 60
          const s1 = 1 / (k + r1)
          const s2 = 1 / (k + r2)
          const total = s1 + s2

          const resultBox = document.getElementById('calc-rrf-result')
          resultBox.innerHTML = `
            <div style="font-size: 0.9rem; color: #334155;">
              <strong>RRF 综合得分</strong>：<span style="color: #2563eb; font-weight: 700;">${total.toFixed(5)}</span>
              （Vector 通道得分: ${s1.toFixed(5)} + BM25 通道得分: ${s2.toFixed(5)}）
            </div>
          `
        })
      }

      // 3. 随堂小测验交互逻辑
      const quizBoxes = document.querySelectorAll('.ai-quiz-box')
      quizBoxes.forEach((box) => {
        const correctAns = box.dataset.ans
        const optBtns = box.querySelectorAll('.ai-quiz-opt-btn')
        const feedback = box.querySelector('.ai-quiz-feedback')

        optBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const userChoice = btn.dataset.choice
            optBtns.forEach((b) => b.classList.remove('correct', 'wrong'))
            if (userChoice === correctAns) {
              btn.classList.add('correct')
            } else {
              btn.classList.add('wrong')
              optBtns.forEach((b) => {
                if (b.dataset.choice === correctAns) b.classList.add('correct')
              })
            }
            if (feedback) feedback.style.display = 'block'
          })
        })
      })

      // 4. 进阶专题折叠/展开
      const questionCards = document.querySelectorAll('.ai-question-card')
      questionCards.forEach((card) => {
        const head = card.querySelector('.ai-q-head')
        head.addEventListener('click', () => {
          card.classList.toggle('expanded')
        })
      })

      // 5. 一键展开与收起
      const btnExpandAll = document.getElementById('btn-expand-all')
      const btnCollapseAll = document.getElementById('btn-collapse-all')

      if (btnExpandAll) {
        btnExpandAll.addEventListener('click', () => {
          document.querySelectorAll('.ai-question-card:not([style*="display: none"])').forEach((c) => c.classList.add('expanded'))
        })
      }
      if (btnCollapseAll) {
        btnCollapseAll.addEventListener('click', () => {
          document.querySelectorAll('.ai-question-card').forEach((c) => c.classList.remove('expanded'))
        })
      }

      // 6. 分类筛选与搜索联动
      let currentCat = 'all'
      let searchQuery = ''

      function filterQuestions() {
        questionCards.forEach((card) => {
          const cardCat = card.dataset.cat
          const text = card.textContent.toLowerCase()
          const matchesCat = currentCat === 'all' || cardCat === currentCat
          const matchesSearch = !searchQuery || text.includes(searchQuery)

          if (matchesCat && matchesSearch) {
            card.style.display = 'block'
          } else {
            card.style.display = 'none'
          }
        })
      }

      const catButtons = document.querySelectorAll('.ai-cat-btn')
      catButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          catButtons.forEach((b) => b.classList.remove('active'))
          btn.classList.add('active')
          currentCat = btn.dataset.cat
          filterQuestions()
        })
      })

      const searchInput = document.getElementById('interview-search')
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value.trim().toLowerCase()
          filterQuestions()
        })
      }

      // 7. 沙箱安全终端模拟器交互逻辑
      const scenarioBtns = document.querySelectorAll('.ai-scenario-btn')
      const terminalOutput = document.getElementById('sandbox-terminal-output')

      const scenarioLogs = {
        rm: `$ python3 agent_task.py
[SECURITY AUDIT] Inspecting syscalls and filesystem bindings...
[BLOCKED] Operation 'os.system("rm -rf /")' intercepted!
[ERROR] Read-only file system: rootfs is mounted as read-only.
[STATUS] Sandbox safe. Host machine 100% protected. Exit Code: 1`,

        scan: `$ python3 agent_task.py
[NETWORK AUDIT] Outbound connection requested -> 192.168.1.1:80
[FIREWALL ALERT] RFC-1918 Private Subnet detected!
[BLOCKED] Unidirectional egress firewall dropped packet to private network.
[STATUS] Internal infrastructure probing prevented. Exit Code: 1`,

        fork: `$ python3 agent_task.py
[WATCHDOG] Execution started at 17:15:00...
[WATCHDOG] CPU usage 100% on Core 0 for 5.00s.
[TIMEOUT TRIGGERED] Hard limit reached (MAX_EXEC_TIME = 5s).
[KILLED] Process terminated by SIGKILL signal. Resource freed.`,

        plot: `$ python3 agent_task.py
[ENVIRONMENT] Python 3.11 with matplotlib, numpy pre-installed.
[COMPUTING] Generating sine curve data points (100 samples)...
[FILE OUTPUT] Saving render to /workspace/output_curve.png ...
[SUCCESS] File exported: 24.8 KB.
[CLEANUP] Sandbox ephemeral volume successfully archived. Exit Code: 0`
      }

      scenarioBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          scenarioBtns.forEach((b) => b.classList.remove('active'))
          btn.classList.add('active')
          const scenario = btn.dataset.scenario
          if (terminalOutput && scenarioLogs[scenario]) {
            terminalOutput.textContent = scenarioLogs[scenario]
          }
        })
      })
    })
  </script>
</Base>
