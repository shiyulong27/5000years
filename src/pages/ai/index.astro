---
import Base from '../../layouts/Base.astro'
import '../../styles/ai.css'
import knowledgeModules from '../../data/ai/knowledge_modules.json'
import interviewQuestions from '../../data/ai/interview_questions.json'

const base = import.meta.env.BASE_URL
---

<Base title="从零开始 · AI 架构与 Agent 工程师系统通关教程 (先修 · LLM · Embedding · RAG · Rank · Memory · Agent · 沙箱 · Harness · Dify) · 十丘" wide={true}>
  <div class="ai-page-wrapper">
    <!-- 顶部导航与全局快速切换 -->
    <header class="ai-top-nav">
      <nav class="ai-breadcrumbs">
        <a href={base}>🏛️ 十丘门户</a>
        <span>/</span>
        <strong style="color: #2563eb;">🤖 AI 架构与 Agent 工程师系统学习教程</strong>
      </nav>
      <div class="ai-nav-pills">
        <a href={base} class="ai-nav-pill">🏠 门户首页</a>
        <a href={`${base}timeline/`} class="ai-nav-pill">📜 历史长卷</a>
        <a href={`${base}geography/`} class="ai-nav-pill">🗺️ 历代舆图</a>
        <a href={`${base}chinese/pinyin/`} class="ai-nav-pill">📖 语文</a>
        <a href={`${base}math/`} class="ai-nav-pill">📐 数学</a>
        <a href={`${base}english/`} class="ai-nav-pill">🔤 英语</a>
        <a href="#interview-bank" class="ai-nav-pill">📚 进阶 FAQ 附录</a>
      </div>
    </header>

    <!-- 顶部沉浸式 Hero Banner -->
    <section class="ai-hero-banner">
      <div class="ai-hero-badge">
        <span>🌱</span> ZERO-TO-HERO · 零基础到工程实战全景教程
      </div>
      <h1 class="ai-hero-title">从零开始 · AI 架构与 Agent 工程师系统教程</h1>
      <p class="ai-hero-desc">
        专为<strong>完全零基础小白</strong>与探索大模型工程落地的<strong>开发者、Agent 架构师、Dify 工程师</strong>打造。全篇采用<strong>高清架构图解 + 大白话通俗比喻 + 丰富生活举例 + 动手代码实操 + 随堂通关小测验</strong>，从最基础的软件工程与数学先修，一路通关到工业级 RAG、记忆系统、Agent 运行时、代码执行沙箱与 Dify 企业实战！
      </p>
      <div class="ai-quick-stats">
        <div class="ai-stat-item">
          <span>🗺️</span> 体系架构：<strong>8 阶循序渐进精讲（Stage 0~7）</strong>
        </div>
        <div class="ai-stat-item">
          <span>🖼️</span> 视觉心智：<strong>8 幅全高清架构流程图解</strong>
        </div>
        <div class="ai-stat-item">
          <span>🧪</span> 动手实操：<strong>交互实验计算器 + 沙箱终端模拟器 + 随堂通关自测</strong>
        </div>
        <div class="ai-stat-item">
          <span>🛠️</span> 生产落地：<strong>Docker 沙箱 / E2B / Dify / Mem0 / HNSW / 双 Harness</strong>
        </div>
      </div>
    </section>

    <!-- 🌟 8 阶循序渐进学习路线图 (Roadmap Stepper) -->
    <section class="ai-roadmap-box">
      <div class="ai-roadmap-head">
        <h2 class="ai-roadmap-title">
          <span>🧭</span> 学习导航 · 8 阶系统化通关路径
        </h2>
        <span style="font-size: 0.82rem; color: #64748b;">点击任意卡片即可直接跳转至对应章节精讲</span>
      </div>

      <div class="ai-roadmap-grid">
        {knowledgeModules.map((m) => (
          <a href={`#${m.id}`} class="ai-roadmap-card">
            <div class="ai-roadmap-icon">{m.icon}</div>
            <div class="ai-roadmap-meta">
              <div class="ai-roadmap-step-tag">STAGE {m.stageNum} · {m.badge}</div>
              <div class="ai-roadmap-step-title">{m.title.split('：')[1] || m.title}</div>
            </div>
          </a>
        ))}
        <a href="#interview-bank" class="ai-roadmap-card" style="border-color: #bfdbfe; background: #eff6ff;">
          <div class="ai-roadmap-icon" style="border-color: #93c5fd; background: #ffffff;">📚</div>
          <div class="ai-roadmap-meta">
            <div class="ai-roadmap-step-tag" style="color: #2563eb;">附录 · 拔高拓展</div>
            <div class="ai-roadmap-step-title" style="color: #1d4ed8;">工程疑难与进阶 FAQ ({interviewQuestions.length}篇)</div>
          </div>
        </a>
      </div>
    </section>

    <!-- 粘性锚点导航栏 -->
    <nav class="ai-sticky-nav" id="sticky-nav">
      <div class="ai-tab-links">
        <a href="#stage0" class="ai-tab-link">🌱 0.先修</a>
        <a href="#stage1" class="ai-tab-link">🧬 1.LLM推理</a>
        <a href="#stage2" class="ai-tab-link">📐 2.向量检索</a>
        <a href="#stage3" class="ai-tab-link">📚 3.RAG全链路</a>
        <a href="#stage4" class="ai-tab-link">⚖️ 4.Rank精排</a>
        <a href="#stage5" class="ai-tab-link">🧠 5.记忆系统</a>
        <a href="#stage6" class="ai-tab-link">🤖 6.Agent与沙箱</a>
        <a href="#stage7" class="ai-tab-link">⚡ 7.双Harness与Dify</a>
        <a href="#interview-bank" class="ai-tab-link" style="color: #2563eb; font-weight: 700;">📚 附录: 进阶FAQ</a>
      </div>
      <a href="#stage0" class="ai-quick-btn" style="padding: 0.35rem 0.8rem; font-size: 0.8rem;">
        🚀 从零开始
      </a>
    </nav>

    <!-- 8 阶知识模块主体 -->
    {knowledgeModules.map((m) => (
      <section class="ai-module-section" id={m.id}>
        <div class="ai-module-header">
          <div class="ai-module-title-group">
            <div class="ai-module-icon">{m.icon}</div>
            <div>
              <h2 class="ai-module-title">{m.title}</h2>
              <div style="font-size: 0.85rem; color: #64748b; margin-top: 0.2rem;">{m.summary}</div>
            </div>
          </div>
          <span class="ai-module-badge" style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1;">
            {m.badge}
          </span>
        </div>

        {/* 💡 小白通俗比喻卡片 */}
        <div class="ai-analogy-card">
          <div class="ai-analogy-icon">💡</div>
          <div>
            <div class="ai-analogy-title">【一句话大白话直觉】</div>
            <p class="ai-analogy-text">{m.analogy}</p>
          </div>
        </div>

        {/* 阶段 0 专属架构图：全景架构数据流转图 */}
        {m.id === 'stage0' && (
          <div class="ai-diagram-card">
            <div class="ai-diagram-head">
              <h4 class="ai-diagram-title"><span>🖼️</span> 架构全景图：现代 AI 应用 7 大组件数据流转与协作</h4>
              <span class="ai-module-badge" style="background: #e0f2fe; color: #0284c7;">DATA FLOW</span>
            </div>
            <p class="ai-diagram-desc">用户请求从 Web/App 端发出，经过业务网关与调度中枢，协调向量库、大模型与沙箱工具，最终以 SSE 流式长连接返回给前端打字机。</p>
            <div class="ai-diagram-svg-wrap">
              <svg viewBox="0 0 880 250" width="100%" height="250" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <marker id="arrow-blue" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M 0 1 L 10 5 L 0 9 z" fill="#3b82f6" />
                  </marker>
                  <marker id="arrow-emerald" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M 0 1 L 10 5 L 0 9 z" fill="#10b981" />
                  </marker>
                </defs>

                {/* 1. Client UI */}
                <rect x="20" y="75" width="115" height="95" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="2"/>
                <text x="77" y="105" font-size="13" font-weight="bold" fill="#1e40af" text-anchor="middle">客户端 UI</text>
                <text x="77" y="128" font-size="11" fill="#64748b" text-anchor="middle">Web / App / 桌面</text>
                <text x="77" y="148" font-size="10" font-weight="bold" fill="#2563eb" text-anchor="middle">打字机 SSE 渲染</text>

                {/* Arrow to Gateway */}
                <line x1="135" y1="110" x2="175" y2="110" stroke="#3b82f6" stroke-width="2" marker-end="url(#arrow-blue)"/>
                <text x="155" y="102" font-size="9" fill="#64748b" text-anchor="middle">POST</text>

                {/* Return SSE stream */}
                <line x1="175" y1="130" x2="135" y2="130" stroke="#10b981" stroke-width="2" stroke-dasharray="4" marker-end="url(#arrow-emerald)"/>
                <text x="155" y="145" font-size="9" fill="#10b981" text-anchor="middle">SSE流</text>

                {/* 2. Backend & Gateway */}
                <rect x="175" y="65" width="130" height="115" rx="8" fill="#f8fafc" stroke="#64748b" stroke-width="1.5"/>
                <text x="240" y="93" font-size="13" font-weight="bold" fill="#0f172a" text-anchor="middle">业务后端网关</text>
                <text x="240" y="118" font-size="11" fill="#475569" text-anchor="middle">鉴权 / 限流防刷</text>
                <text x="240" y="138" font-size="11" fill="#475569" text-anchor="middle">会话 (Redis)</text>
                <text x="240" y="158" font-size="11" fill="#475569" text-anchor="middle">订单 (Postgres)</text>

                {/* Arrow to Orchestrator */}
                <line x1="305" y1="122" x2="345" y2="122" stroke="#3b82f6" stroke-width="2" marker-end="url(#arrow-blue)"/>

                {/* 3. Orchestration Hub (Agent Core) */}
                <rect x="345" y="30" width="165" height="190" rx="10" fill="#faf5ff" stroke="#8b5cf6" stroke-width="2"/>
                <text x="427" y="58" font-size="14" font-weight="bold" fill="#6b21a8" text-anchor="middle">调度中枢 (Orchestrator)</text>
                <text x="427" y="80" font-size="11" fill="#7e22ce" text-anchor="middle">Dify / Agent 运行时</text>
                <line x1="360" y1="90" x2="495" y2="90" stroke="#d8b4fe" stroke-width="1"/>
                <text x="427" y="110" font-size="11" fill="#475569" text-anchor="middle">Prompt 动态拼接</text>
                <text x="427" y="130" font-size="11" fill="#475569" text-anchor="middle">ReAct 控制循环</text>
                <text x="427" y="150" font-size="11" fill="#475569" text-anchor="middle">记忆提取与注入</text>
                <text x="427" y="170" font-size="11" fill="#475569" text-anchor="middle">Trace 链路追踪</text>
                <text x="427" y="195" font-size="11" font-weight="bold" fill="#6b21a8" text-anchor="middle">沙箱调度与熔断</text>

                {/* Branch to Qdrant */}
                <path d="M 510 75 L 565 50" stroke="#3b82f6" stroke-width="2" marker-end="url(#arrow-blue)"/>
                <rect x="565" y="20" width="145" height="55" rx="6" fill="#ecfdf5" stroke="#10b981" stroke-width="1.5"/>
                <text x="637" y="44" font-size="12" font-weight="bold" fill="#065f46" text-anchor="middle">向量数据库与搜索</text>
                <text x="637" y="62" font-size="10" fill="#047857" text-anchor="middle">Qdrant / Milvus / ES</text>

                {/* Branch to LLM */}
                <path d="M 510 125 L 565 125" stroke="#3b82f6" stroke-width="2" marker-end="url(#arrow-blue)"/>
                <rect x="565" y="95" width="145" height="55" rx="6" fill="#eff6ff" stroke="#3b82f6" stroke-width="1.5"/>
                <text x="637" y="119" font-size="12" font-weight="bold" fill="#1e40af" text-anchor="middle">LLM 推理大脑</text>
                <text x="637" y="137" font-size="10" fill="#2563eb" text-anchor="middle">GPT-4o / DeepSeek / Claude</text>

                {/* Branch to Sandbox / Tools */}
                <path d="M 510 175 L 565 200" stroke="#3b82f6" stroke-width="2" marker-end="url(#arrow-blue)"/>
                <rect x="565" y="170" width="145" height="60" rx="6" fill="#fff1f2" stroke="#f43f5e" stroke-width="1.5"/>
                <text x="637" y="194" font-size="12" font-weight="bold" fill="#9f1239" text-anchor="middle">代码沙箱与外部 Tool</text>
                <text x="637" y="213" font-size="10" fill="#be123c" text-anchor="middle">Docker / E2B / MCP 接口</text>

                {/* Right note: Observability */}
                <rect x="735" y="45" width="125" height="155" rx="6" fill="#ffffff" stroke="#cbd5e1" stroke-dasharray="3"/>
                <text x="797" y="70" font-size="12" font-weight="bold" fill="#334155" text-anchor="middle">运维与质检</text>
                <text x="797" y="95" font-size="10" fill="#64748b" text-anchor="middle">📊 Langfuse 链路</text>
                <text x="797" y="118" font-size="10" fill="#64748b" text-anchor="middle">💰 Token 成本核算</text>
                <text x="797" y="140" font-size="10" fill="#64748b" text-anchor="middle">⏱️ P95/P99 延迟</text>
                <text x="797" y="162" font-size="10" fill="#64748b" text-anchor="middle">🎯 幻觉率质检</text>
              </svg>
            </div>
          </div>
        )}

        {/* 阶段 1 专属架构图：Token 与自回归生成机制图 */}
        {m.id === 'stage1' && (
          <div class="ai-diagram-card">
            <div class="ai-diagram-head">
              <h4 class="ai-diagram-title"><span>🖼️</span> 机制图解：从文本切词、KV Cache 到自回归逐词生成</h4>
              <span class="ai-module-badge" style="background: #eff6ff; color: #2563eb;">TOKEN AUTOREGRESSION</span>
            </div>
            <p class="ai-diagram-desc">输入文本经 BPE 分词转化为 Token 序列，自注意力机制结合 KV Cache 快速提取语义特征，Softmax 输出概率分布，由 Temperature 决定下一个词。</p>
            <div class="ai-diagram-svg-wrap">
              <svg viewBox="0 0 880 180" width="100%" height="180" xmlns="http://www.w3.org/2000/svg">
                {/* Step 1: Input text */}
                <rect x="15" y="50" width="115" height="80" rx="6" fill="#f8fafc" stroke="#cbd5e1" stroke-width="1.5"/>
                <text x="72" y="80" font-size="12" font-weight="bold" fill="#0f172a" text-anchor="middle">输入文本</text>
                <text x="72" y="105" font-size="12" fill="#2563eb" text-anchor="middle">"今天天气真好"</text>

                <line x1="130" y1="90" x2="165" y2="90" stroke="#3b82f6" stroke-width="2" marker-end="url(#arrow-blue)"/>

                {/* Step 2: BPE Tokenizer */}
                <rect x="165" y="40" width="135" height="100" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="1.5"/>
                <text x="232" y="68" font-size="12" font-weight="bold" fill="#1e40af" text-anchor="middle">BPE 分词器</text>
                <text x="232" y="90" font-size="10" fill="#475569" text-anchor="middle">拆分为 Token 碎片</text>
                <text x="232" y="115" font-size="11" fill="#2563eb" font-family="monospace" text-anchor="middle">[今天] [天气] [真好]</text>

                <line x1="300" y1="90" x2="335" y2="90" stroke="#3b82f6" stroke-width="2" marker-end="url(#arrow-blue)"/>

                {/* Step 3: Transformer & KV Cache */}
                <rect x="335" y="30" width="170" height="120" rx="8" fill="#faf5ff" stroke="#8b5cf6" stroke-width="2"/>
                <text x="420" y="58" font-size="13" font-weight="bold" fill="#6b21a8" text-anchor="middle">Transformer 核心</text>
                <text x="420" y="78" font-size="10" fill="#7e22ce" text-anchor="middle">多头自注意力 (Self-Attention)</text>
                <rect x="350" y="90" width="140" height="45" rx="6" fill="#f3e8ff" stroke="#c084fc"/>
                <text x="420" y="110" font-size="10" font-weight="bold" fill="#581c87" text-anchor="middle">⚡ KV Cache 显存加速</text>
                <text x="420" y="126" font-size="9" fill="#7e22ce" text-anchor="middle">复用已计算好的键值矩阵</text>

                <line x1="505" y1="90" x2="540" y2="90" stroke="#3b82f6" stroke-width="2" marker-end="url(#arrow-blue)"/>

                {/* Step 4: Probability Softmax & Sampling */}
                <rect x="540" y="40" width="160" height="100" rx="8" fill="#fffbeb" stroke="#f59e0b" stroke-width="1.5"/>
                <text x="620" y="68" font-size="12" font-weight="bold" fill="#92400e" text-anchor="middle">概率分布与采样</text>
                <text x="620" y="90" font-size="10" fill="#b45309" text-anchor="middle">"呀" (60%) / "呢" (25%)</text>
                <text x="620" y="115" font-size="10" fill="#78350f" text-anchor="middle">Temperature 调控平滑度</text>

                <line x1="700" y1="90" x2="735" y2="90" stroke="#3b82f6" stroke-width="2" marker-end="url(#arrow-blue)"/>

                {/* Step 5: Output Token */}
                <rect x="735" y="50" width="130" height="80" rx="6" fill="#ecfdf5" stroke="#10b981" stroke-width="2"/>
                <text x="800" y="80" font-size="12" font-weight="bold" fill="#065f46" text-anchor="middle">吐出新 Token</text>
                <text x="800" y="105" font-size="14" font-weight="bold" fill="#059669" text-anchor="middle">"呀"</text>

                {/* Loopback arrow */}
                <path d="M 800 50 L 800 15 L 420 15 L 420 28" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3" marker-end="url(#arrow-emerald)" fill="none"/>
                <text x="610" y="12" font-size="9" fill="#059669" text-anchor="middle">自回归接龙循环 (Autoregressive Loop)</text>
              </svg>
            </div>
          </div>
        )}

        {/* 阶段 2 专属架构图：HNSW 算法跳跃寻路图 */}
        {m.id === 'stage2' && (
          <div class="ai-diagram-card">
            <div class="ai-diagram-head">
              <h4 class="ai-diagram-title"><span>🖼️</span> 算法图解：HNSW 分层跳跃与六度分割极速寻路</h4>
              <span class="ai-module-badge" style="background: #e0e7ff; color: #3730a3;">HNSW INDEX</span>
            </div>
            <p class="ai-diagram-desc">类似跳表（Skip-List）的分层结构：从稀疏顶层进行大跨度高速跳跃，逐步收敛至底层稠密近邻图，在毫秒级内从千万向量中精准定位 Top-K。</p>
            <div class="ai-diagram-svg-wrap">
              <svg viewBox="0 0 880 180" width="100%" height="180" xmlns="http://www.w3.org/2000/svg">
                {/* Layer 2 (Top Highway) */}
                <rect x="30" y="20" width="820" height="36" rx="6" fill="#f1f5f9" stroke="#94a3b8" stroke-dasharray="3"/>
                <text x="50" y="42" font-size="11" font-weight="bold" fill="#475569">Layer 2 (高速路跨区跳跃)</text>
                <circle cx="200" cy="38" r="8" fill="#3b82f6"/>
                <line x1="208" y1="38" x2="480" y2="38" stroke="#3b82f6" stroke-width="2.5"/>
                <circle cx="488" cy="38" r="8" fill="#3b82f6"/>
                <line x1="496" y1="38" x2="720" y2="38" stroke="#3b82f6" stroke-width="2.5"/>
                <circle cx="728" cy="38" r="8" fill="#3b82f6"/>

                {/* Down arrow 1 */}
                <line x1="488" y1="46" x2="488" y2="70" stroke="#f59e0b" stroke-width="2" stroke-dasharray="3"/>

                {/* Layer 1 (Medium Sub-highway) */}
                <rect x="30" y="70" width="820" height="42" rx="6" fill="#eff6ff" stroke="#93c5fd"/>
                <text x="50" y="95" font-size="11" font-weight="bold" fill="#1e40af">Layer 1 (中层支路定位城市)</text>
                <circle cx="340" cy="91" r="7" fill="#60a5fa"/>
                <line x1="347" y1="91" x2="480" y2="91" stroke="#60a5fa" stroke-width="2"/>
                <circle cx="488" cy="91" r="8" fill="#2563eb"/>
                <line x1="496" y1="91" x2="600" y2="91" stroke="#60a5fa" stroke-width="2"/>
                <circle cx="608" cy="91" r="7" fill="#60a5fa"/>

                {/* Down arrow 2 */}
                <line x1="608" y1="99" x2="608" y2="124" stroke="#f59e0b" stroke-width="2" stroke-dasharray="3"/>

                {/* Layer 0 (Dense Bottom Ground) */}
                <rect x="30" y="125" width="820" height="45" rx="6" fill="#ecfdf5" stroke="#86efac"/>
                <text x="50" y="152" font-size="11" font-weight="bold" fill="#065f46">Layer 0 (底层全量稠密图)</text>
                <circle cx="420" cy="148" r="6" fill="#34d399"/>
                <circle cx="480" cy="148" r="6" fill="#34d399"/>
                <circle cx="540" cy="148" r="6" fill="#34d399"/>
                <circle cx="608" cy="148" r="8" fill="#059669"/>
                <circle cx="660" cy="148" r="8" fill="#10b981"/>
                <circle cx="710" cy="148" r="6" fill="#34d399"/>
                <line x1="546" y1="148" x2="600" y2="148" stroke="#059669" stroke-width="1.5"/>
                <line x1="616" y1="148" x2="652" y2="148" stroke="#059669" stroke-width="2.5"/>
                <line x1="668" y1="148" x2="704" y2="148" stroke="#059669" stroke-width="1.5"/>

                {/* Query entrance badge */}
