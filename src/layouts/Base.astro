---
import '../styles/global.css'

const {
  title = '上下五千年',
  wide = false,
  description = '',
  head = '',
} = Astro.props
const base = import.meta.env.BASE_URL
const desc = description || '上下五千年 · 中国历史长卷，与世界文明对照'
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    {head && <Fragment set:html={head} />}
  </head>
  <body class={wide ? 'wide' : ''}>
    <slot />
  </body>
</html>
