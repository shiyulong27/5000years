---
import '../styles/global.css'

const { title = '上下五千年', wide = false } = Astro.props
const base = import.meta.env.BASE_URL
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="上下五千年 · 中国历史长卷，与世界文明对照" />
  </head>
  <body class={wide ? 'wide' : ''}>
    <slot />
  </body>
</html>
