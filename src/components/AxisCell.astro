---
import { formatDate } from '../lib/date.js'

const { row } = Astro.props
const { year, dynasties, rulers } = row

const label = year < 0 ? `前${Math.abs(year)}` : String(year)
const base = import.meta.env.BASE_URL
const hasSummary = [1942, 1943, 1944, 1945, 1946, 1947, 1948, 1949, 1950, 1951, 1952, 1953, 1954, 1955, 1956, 1957, 1958, 1959, 1960, 1961, 1962, 1963, 1964, 1965, 1966, 1967, 1968, 1969, 1970, 1971, 1972, 1973, 1974, 1975, 1976, 1977, 1978, 1979, 1980, 1981, 1982, 1983, 1984, 1985, 1986, 1987, 1988, 1989, 1990, 1991, 1992, 1993, 1994, 1995, 1996, 1997, 1998, 1999, 2000, 2001, 2002, 2003, 2004, 2005, 2006, 2007, 2008, 2009, 2010, 2011, 2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026].includes(year)
// 2008~2026 全部默认展开 (detail)
const defaultMode = 'detail'
---

<div class="axis-cell" data-year={year}>
  {hasSummary ? (
    <div class="axis-year-group">
      <a href={`${base}${year}/`} class="axis-year-link" title={`点击进入 ${label} 年独立专页`}>
        <span class="axis-year clickable-year">{label}</span>
      </a>

      <button
        type="button"
        class="axis-toggle-btn"
        data-year={year}
        data-mode={defaultMode}
        title="点击切换：[概览] 方框卡片 与 [详情] 多条展开"
      >
        <span class="toggle-text">{defaultMode === 'summary' ? '概览' : '详情'}</span>
        <span class="toggle-icon">⇄</span>
      </button>
    </div>
  ) : (
    <span class="axis-year">{label}</span>
  )}

  {/* 分裂期同年多政权，色带并排显示 */}
  <div class="axis-bands">
    {dynasties.map((d) => (
      <span class="axis-band" style={`background:${d.color}`} title={d.name}></span>
    ))}
  </div>

  {rulers.length > 0 && (
    <span class="axis-rulers">{rulers.map((r) => r.temple_name).join('・')}</span>
  )}
</div>
