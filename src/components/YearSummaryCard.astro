---
import { formatDate } from '../lib/date.js'

const { year = 2025, events = [] } = Astro.props
const base = import.meta.env.BASE_URL

// 挑选该年份最重要/核心的中国事件（优先 5 级、4 级，若不足则取前 3~5 条）
const importantEvents = [...events].sort((a, b) => (b.importance ?? 3) - (a.importance ?? 3))
// 取重要度最高的前 5 条，再按时间正序排列
const topEvents = importantEvents.slice(0, 5).sort((a, b) => a.date.localeCompare(b.date))
---

<a href={`${base}${year}/`} class="year-summary-card-link" title={`点击进入 ${year} 年独立专页`}>
  <article class="event-card card-major" id={`cn-summary-${year}`} data-category="政治" data-importance="5">
    <header class="event-head">
      <time class="event-date">{year}年</time>
      <span class="event-cat">中国要闻概览</span>
      <span class="event-badge badge-major" title="点击进入该年份完整专页">
        查看专页 ➔
      </span>
    </header>

    <h3 class="event-title">{year}年中国核心要闻</h3>

    {topEvents.length > 0 ? (
      <ul class="summary-highlights-list">
        {topEvents.map((e) => {
          const formatted = formatDate(e.date)
          const shortDate = formatted.includes('年') ? formatted.split('年')[1] : formatted
          return (
            <li class="summary-highlight-item">
              <span class="highlight-date">{shortDate || formatted}</span>
              <span class="highlight-title">{e.title}</span>
            </li>
          )
        })}
      </ul>
    ) : (
      <p class="event-summary">{year}年中国历史重大事件要览。</p>
    )}
  </article>
</a>
