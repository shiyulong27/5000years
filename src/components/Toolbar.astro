---
import { CATEGORIES } from '../lib/enums.js'

const { dynasties } = Astro.props
---

<div class="toolbar">
  <div class="tool-group tool-switches">
    <div class="level-multiselect" id="level-multiselect" title="按重要度等级多选筛选事件">
      <button type="button" class="level-dropdown-btn" id="level-dropdown-btn" aria-haspopup="true" aria-expanded="false">
        <span class="btn-text" id="level-btn-text">等级: 4级, 5级</span>
        <span class="btn-arrow">▾</span>
      </button>
      <div class="level-dropdown-menu" id="level-dropdown-menu" hidden>
        <label class="level-option">
          <input type="checkbox" class="level-toggle" value="5" checked />
          <span class="level-label">👑 5级 (历史转折)</span>
        </label>
        <label class="level-option">
          <input type="checkbox" class="level-toggle" value="4" checked />
          <span class="level-label">⭐ 4级 (重大事件)</span>
        </label>
        <label class="level-option">
          <input type="checkbox" class="level-toggle" value="3" />
          <span class="level-label">📌 3级 (常态事件)</span>
        </label>
        <label class="level-option">
          <input type="checkbox" class="level-toggle" value="2" />
          <span class="level-label">📝 2级 (一般细节)</span>
        </label>
        <label class="level-option">
          <input type="checkbox" class="level-toggle" value="1" />
          <span class="level-label">📜 1级 (补遗史料)</span>
        </label>
      </div>
    </div>

    {/* 全局视图控制：控制 2023, 2024, 2025, 2026 等年份一键切换 [全展开] 或 [概览卡片] */}
    <div class="global-view-switch" id="global-view-switch" title="一键控制近现代年份视图：[全展开] 或 [概览卡片]">
      <span class="view-switch-label">视图:</span>
      <button type="button" class="view-mode-btn active" data-view="detail" id="btn-view-detail">全展开</button>
      <button type="button" class="view-mode-btn" data-view="summary" id="btn-view-summary">概览卡片</button>
    </div>

    {/* 排序顺序：正序（上古→现代）或倒序（现代→上古） */}
    <div class="sort-order-switch" id="sort-order-switch" title="切换时间轴排列顺序">
      <span class="view-switch-label">排序:</span>
      <button type="button" class="view-mode-btn active" data-order="asc" id="btn-sort-asc">↑ 正序</button>
      <button type="button" class="view-mode-btn" data-order="desc" id="btn-sort-desc">↓ 倒序</button>
    </div>

    <label class="switch switch-world">
      <input type="checkbox" class="switch-input" id="show-world" checked />
      <span class="switch-label">世界对照</span>
    </label>

    <label class="switch switch-figures">
      <input type="checkbox" class="switch-input" id="show-figures" />
      <span class="switch-label">人物</span>
    </label>
  </div>

  <div class="tool-group tool-cats">
    {CATEGORIES.map((c) => (
      <label class="chip" data-cat={c}>
        <input type="checkbox" class="cat-toggle chip-input" value={c} checked />
        <span class="chip-label">{c}</span>
      </label>
    ))}
  </div>

  <div class="tool-group tool-jump">
    <select class="jump-select" id="jump-dynasty">
      <option class="jump-option jump-placeholder" value="">跳转朝代…</option>
      {dynasties.map((d) => (
        <option class="jump-option" value={d.id}>{d.name}</option>
      ))}
    </select>
  </div>

  <span class="tool-current" id="current-dynasty"></span>
</div>
