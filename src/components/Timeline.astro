---
import AxisCell from './AxisCell.astro'
import EventCard from './EventCard.astro'
import CivBand from './CivBand.astro'
import FigureBand from './FigureBand.astro'
import DynastyBanner from './DynastyBanner.astro'

const { rows, bands, figureBands = [], columns } = Astro.props

// 列构成：[文明 × N][世界事件][中轴][人物 × M][中国事件]
// N、M 与各列位置来自 timeline.js，组件不自行计算。
const civCount = columns.total
const figCount = columns.figureLanes ?? 0

const colWorld = civCount + 1
const colAxis = civCount + 2
const colFigStart = civCount + 3
const colChina = civCount + 3 + figCount
const colTotal = colChina
---

<div
  class="timeline"
  style={`--civ-count:${civCount};--fig-count:${figCount};--col-total:${colTotal}`}
  data-has-figures={figCount > 0 ? 'true' : 'false'}
>
  {/* 文明色带：跨越多行，各据其 region 列 */}
  {bands.map((band) => <CivBand band={band} />)}

  {/* 人物生卒带：贪心排布的泳道，默认由 CSS 隐藏 */}
  {figureBands.map((band) => (
    <div
      class="figure-slot"
      style={`grid-row:${band.rowStart}/${band.rowEnd + 1};grid-column:${colFigStart + band.lane};--lane:${band.lane}`}
    >
      <FigureBand band={band} />
    </div>
  ))}

  {rows.map((row) =>
    row.type === 'banner' ? (
      // 横幅跨「中轴 + 中国事件」，不越入世界栏。
      //
      // 中轴不是中立的——它装着朝代色带与在位君主，都是中国的内容。
      // 故长卷真正的分界在 [文明带][世界事件] │ [中轴][中国事件]，
      // 横幅须守住这条线：读者顺世界栏下扫时，不该撞上「秦都咸阳」。
      //
      // 跨中轴而非仅在其右：横幅行的中轴是空的（不渲染年份），占用零成本；
      // 且朝代色带就在中轴里，横幅紧贴色带才说得通「这条带子是什么」。
      <div class="banner-row" style={`grid-row:${row.gridRow};grid-column:${colAxis}/-1`}>
        <DynastyBanner dynasty={row.dynasty} rulers={row.rulers} />
      </div>
    ) : (
      <>
        <div class="cell cell-world" style={`grid-row:${row.gridRow};grid-column:${colWorld}`}>
          {row.worldEvents.map((e) => <EventCard event={e} />)}
        </div>

        <div class="cell cell-axis" style={`grid-row:${row.gridRow};grid-column:${colAxis}`}>
          <AxisCell row={row} />
        </div>

        <div
          class="cell cell-china"
          style={`grid-row:${row.gridRow};grid-column:${colChina}`}
          data-year={row.year}
          data-dynasty={row.dynasties.map((d) => d.id).join(' ')}
        >
          {row.cnEvents.map((e) => <EventCard event={e} />)}
        </div>
      </>
    )
  )}
</div>
