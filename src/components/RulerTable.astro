---
import { yearOf } from '../lib/date.js'

const { rulers, dynasties } = Astro.props

const fmt = (d) => {
  const y = yearOf(d)
  return y < 0 ? `前${Math.abs(y)}` : String(y)
}

const nameOf = (id) => dynasties.find((d) => d.id === id)?.name ?? id
const multi = new Set(rulers.map((r) => r.dynasty)).size > 1
---

{rulers.length > 0 && (
  <table class="ruler-table">
    <thead class="rt-head">
      <tr class="rt-row rt-row-head">
        {multi && <th class="rt-th rt-th-dynasty">朝代</th>}
        <th class="rt-th rt-th-temple">庙号</th>
        <th class="rt-th rt-th-name">姓名</th>
        <th class="rt-th rt-th-reign">在位</th>
        <th class="rt-th rt-th-era">年号</th>
        <th class="rt-th rt-th-note">备注</th>
      </tr>
    </thead>
    <tbody class="rt-body">
      {rulers.map((r) => (
        <tr class="rt-row" data-dynasty={r.dynasty} data-role={r.role ?? ''}>
          {multi && <td class="rt-td rt-td-dynasty">{nameOf(r.dynasty)}</td>}
          <td class="rt-td rt-td-temple">{r.temple_name}</td>
          <td class="rt-td rt-td-name">{r.name ?? ''}</td>
          <td class="rt-td rt-td-reign">{fmt(r.reign_start)}–{fmt(r.reign_end)}</td>
          <td class="rt-td rt-td-era">{r.era_names?.join('、') ?? ''}</td>
          <td class="rt-td rt-td-note">{r.note ?? ''}</td>
        </tr>
      ))}
    </tbody>
  </table>
)}
